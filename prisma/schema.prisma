// cadence database schema
// single-user for now, but structured to be auth-ready: adding a `User` model
// and a nullable `userId` to Playlist / LikedSong / PlayHistory later is additive
// and does not require reworking these tables.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm(map: "pg_trgm")]
}

model User {
  id        String   @id // Auth0 `sub`
  email     String?
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  songs       Song[]
  playlists   Playlist[]
  likedSongs  LikedSong[]
  playHistory PlayHistory[]

  @@map("users")
}

model Song {
  id       String  @id @default(uuid())
  name     String
  artist   String
  album    String?
  duration Int // seconds
  genre    String?
  bpm      Int?
  key      String?
  imageUrl String?
  audioUrl String
  isLocal  Boolean @default(true)
  isDemo   Boolean @default(false)
  userId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistSongs PlaylistSong[]
  likedSongs    LikedSong[]
  playHistory   PlayHistory[]

  @@index([userId])
  @@index([isDemo])
  @@index([name])
  @@index([artist])
  @@index([album])
  @@index([createdAt])
  // trigram indexes power the fuzzy search (similarity()) query
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "songs_name_trgm")
  @@index([artist(ops: raw("gin_trgm_ops"))], type: Gin, map: "songs_artist_trgm")
  @@map("songs")
}

model Playlist {
  id       String  @id @default(uuid())
  name     String
  coverUrl String?
  isDemo   Boolean @default(false)
  userId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistSongs PlaylistSong[]

  @@index([userId])
  @@index([isDemo])
  @@index([createdAt])
  @@map("playlists")
}

model PlaylistSong {
  id         String   @id @default(uuid())
  playlistId String
  songId     String
  order      Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
  @@index([playlistId])
  @@index([songId])
  @@index([order])
  @@map("playlist_songs")
}

model LikedSong {
  id      String   @id @default(uuid())
  userId  String
  songId  String
  likedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@index([userId])
  @@index([songId])
  @@map("liked_songs")
}

model PlayHistory {
  id       String   @id @default(uuid())
  userId   String
  songId   String
  playedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([playedAt])
  @@index([songId])
  @@map("play_history")
}
